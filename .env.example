# Copy to .env beside compose.prod.yml and fill in. .env is gitignored.
#
# Every line reaches the container exactly as written. Nothing is escaped or
# interpolated, so paste values verbatim — a bcrypt hash included.

# ---- Required ----

# Unlocks the keyring provider credentials are encrypted with; the process
# refuses to start without it, and a database opened under a different key
# cannot read what it holds. Generate once and keep a copy off this host:
#   openssl rand -base64 32
DARKROUTER_MASTER_KEY=

# The bcrypt hash the dashboard logs in against. Leaving it empty closes the
# dashboard rather than opening it: the gateway still proxies, but every login
# is refused. Produce the value with:
#   docker run --rm --entrypoint darkrouter darkraise/darkrouter:latest \
#     hash-password -password 'yours'
DARKROUTER_ADMIN_PASSWORD_HASH=

# ---- Optional ----
#
# Everything below has a working default. Uncomment only what you need.

# Bearer token the gateway requires from clients. Unset means proxy
# authentication is off, which is the wrong posture for anything reachable
# from the internet.
#DARKROUTER_PROXY_TOKEN=

# Which published tag to run, and the host ports it is published on. The
# container always listens on 8080 and 8081 internally.
#DARKROUTER_TAG=latest
#PROXY_PORT=8080
#ADMIN_PORT=8081

# Process log shape and level: text (default) or json; debug, info (default),
# warn or error. Every line carries the request id the trace drawer shows.
#DARKROUTER_LOG_FORMAT=json
#DARKROUTER_LOG_LEVEL=debug

# Providers added in the dashboard are stored encrypted in the database and
# need nothing here. A key is only needed for a provider written into
# data/darkrouter.yaml as ${SOME_KEY}, and any name works — whatever the
# config file references reaches the container from here.
#GROQ_KEY=

# An alternative to running `auggie login` inside the container: the bundled
# Augment CLI reads its session from here when it is set.
#AUGMENT_SESSION_AUTH=
