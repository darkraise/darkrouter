# Copy to .env beside compose.prod.yml and fill in. .env is gitignored.

# Which published tag to run. Pin to a sha- tag to roll back.
DARKROUTER_TAG=latest

# Host ports. The container always listens on 8080/8081 internally.
PROXY_PORT=8080
ADMIN_PORT=8081

# Required. Unlocks the keyring provider credentials are encrypted with.
# Losing it means losing every stored credential -- keep a copy off this host.
DARKROUTER_MASTER_KEY=

# Optional. Unset turns proxy authentication off, which is the wrong posture
# for anything reachable from the internet.
DARKROUTER_PROXY_TOKEN=

# Optional, and unset closes the dashboard rather than opening it.
#   docker run --rm --entrypoint darkrouter darkraise/darkrouter:latest \
#     hash-password -password 'yours'
# DOUBLE EVERY DOLLAR SIGN: compose interpolates .env, so a bcrypt hash pasted
# verbatim arrives truncated and a correct password is refused.
#   $2a$12$abc...  ->  $$2a$$12$$abc...
DARKROUTER_ADMIN_PASSWORD_HASH=

# Provider keys the configuration interpolates. Providers added through the
# dashboard are stored encrypted in the database and need nothing here.
GROQ_KEY=
ANTHROPIC_KEY=
GEMINI_KEY=

# Optional. Process log shape and level: text (default) or json;
# debug, info (default), warn or error. Every line carries the request id
# where one exists, which is the same id the trace drawer shows.
DARKROUTER_LOG_FORMAT=
DARKROUTER_LOG_LEVEL=

# Only read when the edge profile is enabled.
ADMIN_DOMAIN=
PROXY_DOMAIN=
